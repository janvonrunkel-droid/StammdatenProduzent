# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (Required for PROJ-4: PDF Upload & Storage)
# Used server-side for storage operations and admin actions
# WARNING: Never expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OpenAI API Key (Required for PROJ-10: RAG Chat Interface)
# Used for chat completions (GPT-4o-mini) and embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-your_openai_api_key_here

# PROJ-12 Phase 4+5: Auto-Import Pipeline & Cloud-Integration
# Encryption key for OAuth tokens and sensitive credentials (32 bytes = 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_hex_character_encryption_key_here

# Vercel Cron Job authentication secret
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET=your_cron_secret_here

# Google Drive OAuth (for gdrive import source type)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/auth/gdrive/callback

# Dropbox OAuth (for dropbox import source type)
DROPBOX_CLIENT_ID=your_dropbox_app_key
DROPBOX_CLIENT_SECRET=your_dropbox_app_secret
DROPBOX_REDIRECT_URI=https://your-domain.vercel.app/api/auth/dropbox/callback

# Add more environment variables as needed
# STRIPE_SECRET_KEY=sk_...
# SMTP_HOST=smtp.sendgrid.net
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
